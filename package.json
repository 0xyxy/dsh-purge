{
  "name": "dsh-purge-community",
  "version": "1.2.0",
  "description": "Purge Community：独立维护的 DSH 提示词与规则管理插件，统一右侧设置、版本兼容检测、备份及插件回滚。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "purge-community": "bin/community.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin/community.js",
    "docs",
    "presets",
    "skills",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node packages/purge-panel/scripts/build.mjs --community",
    "test": "node --test test/community.test.mjs",
    "test:ui": "node packages/purge-panel/test/community.cjs",
    "check:client": "node packages/purge-panel/scripts/build.mjs --community --check"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "purge-community",
    "prompt-management",
    "rules",
    "agent",
    "backup",
    "rollback",
    "compatibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingcharleslzy-ai/dsh-purge.git"
  },
  "homepage": "https://github.com/kingcharleslzy-ai/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/kingcharleslzy-ai/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/kingcharleslzy-ai/dsh-purge/releases/latest/download/dsh-purge-community-1.2.0.tgz",
      "git": "https://github.com/kingcharleslzy-ai/dsh-purge.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dshTarget": "0.2.1-rc.1 (runtime only; host binary patches disabled)",
  "contributors": [
    "小杨 / YuJunZhiXue (original dsh-purge author)"
  ]
}
