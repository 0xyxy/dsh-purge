{
  "name": "dsh-purge-panel",
  "version": "1.0.0",
  "description": "Purge 界面：独立右侧入口与原生风格设置页，官方 Purge 可单独更新。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "test": "node --check client.js && node test/check.cjs"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kingcharleslzy-ai/dsh-purge.git",
    "directory": "packages/purge-panel"
  }
}
